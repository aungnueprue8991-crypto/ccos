[Unit]
Description=NEXUS x CCOS Docker Compose stack
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/nexus
Environment=NEXUS_HOME=/var/lib/nexus
ExecStart=/usr/bin/docker compose -f /opt/nexus/deploy/docker/docker-compose.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f /opt/nexus/deploy/docker/docker-compose.yml down

[Install]
WantedBy=multi-user.target
